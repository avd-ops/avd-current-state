# Line endings stay LF in the repo whatever the clone's core.autocrlf (avd-ops docs/run-anywhere.md).
* text=auto eol=lf
*.sh text eol=lf

# Vendored contract files are hashed byte for byte (contracts/PINS.json).
contracts/*.json -text
# So is the method (assess/PINS.json), which the facts script checks before -Assess.
assess/*.json -text
assess/*.psm1 -text
# So is the check catalog schema (checks/PINS.json).
checks/check-catalog.schema.json -text
# So is the portal engine copy (site/assets/engine.lock.json).
site/assets/engine/* -text
# So is the design system copy (site/assets/design-system.lock.json).
site/assets/* -text
site/assets/brand/* -text
site/assets/fonts/* -text

# Fixtures are compared byte for byte with generated strings.
tests/portal/fixtures/* -text
