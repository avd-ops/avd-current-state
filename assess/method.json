  "checks": [
    {
      "id": "asm-personal-start-vm-on-connect",
      "title": "Personal host pools use Start VM on Connect",
      "pillar": "cost",
      "severity": "low",
      "claims": [
        "ref:review-checklists-avd#E01.05"
      ],
      "facts": [
        "c11.hostPool.type",
        "c11.hostPool.startVmOnConnect"
      ],
      "rule": {
        "each": "/subscriptions/*/hostPools/*",
        "where": {
          "type": {
            "eq": "Personal"
          }
        },
        "expect": {
          "startVmOnConnect": {
            "eq": true
          }
        },
        "onFail": "warn"
      },
      "informs": [
        "hostPool.power"
      ],
      "remediation": {
        "kind": "lz-parameter",
        "name": "startVmOnConnect",
        "to": true
      }
    },
    {
      "id": "asm-pooled-host-redundancy",
      "title": "Pooled host pools have at least two session hosts",
      "pillar": "reliability",
      "severity": "medium",
      "claims": [
        "ref:waf-reliability-checklist#RE:05"
      ],
      "facts": [
        "c11.hostPool.type",
        "c11.hostPool.sessionHosts.total"
      ],
      "rule": {
        "each": "/subscriptions/*/hostPools/*",
        "where": {
          "type": {
            "eq": "Pooled"
          }
        },
        "expect": {
          "sessionHosts/total": {
            "min": 2
          }
        },
        "onFail": "warn"
      },
      "informs": [
        "hostPool.hosts"
      ],
      "remediation": {
        "kind": "lz-parameter",
        "name": "sessionHostCount",
        "to": 2
      }
    },
    {
      "id": "asm-files-private-endpoint",
      "title": "Premium file storage is reached through a private endpoint",
      "pillar": "security",
      "severity": "medium",
      "claims": [
        "ref:review-checklists-avd#F01.10"
      ],
      "facts": [
        "c11.storage.kind",
        "c11.storage.privateEndpoint"
      ],
      "rule": {
        "each": "/subscriptions/*/storageAccounts/*",
        "where": {
          "kind": {
            "eq": "FileStorage"
          }
        },
        "expect": {
          "privateEndpoint": {
            "eq": true
          }
        },
        "onFail": "warn"
      },
      "informs": [
        "network"
      ],
      "remediation": {
        "kind": "lz-setting",
        "name": "profile-storage-private-endpoint"
      }
    },
    {
      "id": "asm-files-zone-redundant",
      "title": "Premium file storage is zone-redundant",
      "pillar": "reliability",
      "severity": "high",
      "claims": [
        "ref:review-checklists-avd#A03.05",
        "ref:psrule-azure#AZR-000195"
      ],
      "facts": [
        "c11.storage.kind",
        "c11.storage.sku"
      ],
      "rule": {
        "each": "/subscriptions/*/storageAccounts/*",
        "where": {
          "kind": {
            "eq": "FileStorage"
          }
        },
        "expect": {
          "sku": {
            "eq": "Premium_ZRS"
          }
        },
        "onFail": "warn"
      },
      "informs": [],
      "remediation": {
        "kind": "lz-parameter",
        "name": "profileStorageSku",
        "to": "Premium_ZRS"
      }
    },
    {
      "id": "asm-hosts-trusted-launch",
      "title": "Session hosts run Trusted launch with Secure Boot and vTPM on",
      "pillar": "security",
      "severity": "medium",
      "claims": [
        "ref:review-checklists-avd#G02.03",
        "ref:avd-security-guide#trusted-launch"
      ],
      "facts": [
        "c11.hostPool.sessionHosts.notTrustedLaunch"
      ],
      "rule": {
        "each": "/subscriptions/*/hostPools/*",
        "expect": {
          "sessionHosts/notTrustedLaunch": {
            "max": 0
          }
        },
        "onFail": "warn"
      },
      "informs": [],
      "remediation": {
        "kind": "manual",
        "code": "rebuild-hosts"
      }
    },
    {
      "id": "asm-drive-usb-redirection-off",
      "title": "Host pools turn drive and USB redirection off",
      "pillar": "security",
      "severity": "medium",
      "claims": [
        "ref:review-checklists-avd#G02.06",
        "ref:avd-security-guide#device-redirection"
      ],
      "facts": [
        "c11.hostPool.redirection.drives",
        "c11.hostPool.redirection.usb"
      ],
      "rule": {
        "each": "/subscriptions/*/hostPools/*",
        "expect": {
          "redirection/drives": {
            "eq": "off"
          },
          "redirection/usb": {
            "eq": "off"
          }
        },
        "onFail": "warn"
      },
      "informs": [],
      "remediation": {
        "kind": "lz-parameter",
        "name": "rdpProperties"
      }
    },
    {
      "id": "asm-defender-servers",
      "title": "Defender for Cloud's Servers plan is on",
      "pillar": "security",
      "severity": "medium",
      "claims": [
        "ref:review-checklists-avd#G03.04",
        "ref:avd-security-guide#defender-for-cloud"
      ],
      "facts": [
        "c11.subscription.defenderPlans"
      ],
      "rule": {
        "each": "/subscriptions/*",
        "expect": {
          "defenderPlans/VirtualMachines": {
            "eq": "Standard"
          }
        },
        "onFail": "warn"
      },
      "informs": [],
      "remediation": {
        "kind": "lz-parameter",
        "name": "enableDefenderForCloud",
        "to": true
      }
    },
    {
      "id": "asm-files-smb-gcm",
      "title": "Premium file storage allows only GCM SMB channel encryption, AES-128-GCM included",
      "pillar": "security",
      "severity": "medium",
      "claims": [
        "ref:mcsb-avd-baseline#DP-3"
      ],
      "facts": [
        "c11.storage.kind",
        "c11.storage.smbChannelEncryption"
      ],
      "rule": {
        "each": "/subscriptions/*/storageAccounts/*",
        "where": {
          "kind": {
            "eq": "FileStorage"
          }
        },
        "expect": {
          "smbChannelEncryption": {
            "eq": "gcm"
          }
        },
        "onFail": "warn"
      },
      "informs": [],
      "remediation": {
        "kind": "lz-setting",
        "name": "profile-storage-smb-gcm"
      }
    },
    {
      "id": "asm-policy-guardrails-assigned",
      "title": "Subscriptions holding AVD have at least one Azure Policy assignment in scope",
      "pillar": "operations",
      "severity": "low",
