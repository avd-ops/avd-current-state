{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assess.avd-ops.dev/schemas/avd-check-catalog/v1.json",
  "title": "avd-check-catalog/v1: the operational checks avd-current-state runs (checks/catalog.json)",
  "description": "Contract C22. One entry per preflight, postflight or drift check that avd-current-state runs and avd-landing-zone vendors (avd-current-state docs/checks-spec.md). Operational checks aren't assessment method, so they live in that catalog and cite avd-assess claims where one exists, or a gap. A check is a C20-shaped rule over registered facts, the name of a coded check (a pure function, never code in the catalog), or a method check listed by its asm- ID whose rule exists once, in method.json. Every check only reads; a remediation is a hint for the plan, never a command that writes. The shared definitions ($defs deprecated to line, and rule) are the C20 method schema's, kept equal by tests/check_contracts.py.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "checks"
  ],
  "additionalProperties": false,
  "$defs": {
    "deprecated": {
      "type": "object",
      "description": "Marks an ID that a later major release may remove (docs/distribution-spec.md section 6): the release that first carried the mark and the ID that replaces it, if any. Readers keep using a deprecated ID until it is gone.",
      "required": [
        "since"
      ],
      "additionalProperties": false,
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "replacedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "remediation": {
      "type": "object",
      "description": "What would make a non-pass outcome pass, as a hint for the remediation plan (C24). lz-parameter: an avd-landing-zone parameter and the public value it should take; lz-setting: something the landing zone always applies, so a redeploy from it fixes the finding; manual: outside what a landing zone redeploy fixes, with a code, never free text (rebuild-hosts: hosts the landing zone deploys have it, existing hosts must be replaced).",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "lz-parameter",
            "lz-setting",
            "manual"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9-]{2,60}$"
        },
        "to": {
          "$ref": "#/$defs/publicValue"
        },
        "code": {
          "enum": [
            "collect-evidence",
            "rebuild-hosts",
            "private-value",
            "outside-landing-zone",
            "process",
            "no-known-change"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "code"
            ],
            "properties": {
              "name": false,
              "to": false
            }
          },
          "else": {
            "required": [
              "name"
            ],
            "properties": {
              "code": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "lz-setting"
              }
            }
          },
          "then": {
            "properties": {
              "to": false
            }
          }
        }
      ]
    },
    "publicValue": {
      "description": "A public value only: a SKU, a count, a boolean, a region. Never a name, prefix or address: a string starts with a letter and holds only letters, digits and underscores, so an address, a CIDR prefix or a hyphenated resource name can't pass.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "factId": {
      "type": "string",
      "pattern": "^(c11|c12|intake|liquidware)\\.[A-Za-z0-9.]{2,80}$"
    },
    "claimRef": {
      "type": "string",
      "pattern": "^ref:[a-z0-9][a-z0-9-]{1,63}#[A-Za-z0-9][A-Za-z0-9.:-]{0,63}$"
    },
    "gapRef": {
      "type": "string",
      "pattern": "^gap:[a-z0-9][a-z0-9-]{1,63}$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/([A-Za-z][A-Za-z0-9]{0,40}|\\*))+$",
      "description": "JSON pointer into a C11 snapshot or a C19 intake; * is every array item"
    },
    "property": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}(/[A-Za-z][A-Za-z0-9]{0,40}){0,3}$",
      "description": "Relative to each subject"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "test": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "eq": {
          "$ref": "#/$defs/scalar"
        },
        "ne": {
          "$ref": "#/$defs/scalar"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "line": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[^\\n\\r]+$"
    },
    "source": {
      "enum": [
        "arm",
        "resource-graph",
        "change-log",
        "activity-log",
        "deployment-record",
        "graph",
        "intake"
      ],
      "description": "Where a check reads what isn't a registered fact: ARM REST, a Resource Graph table, the Resource Graph change log (resourcechanges), the Activity Log, a deployment's record, Microsoft Graph, the operator's intake"
    },
    "rule": {
      "type": "object",
      "required": [
        "each",
        "expect"
      ],
      "additionalProperties": false,
      "description": "For each subject at 'each' that matches 'where', every 'expect' test must hold. A missing property makes that subject unknown, never a failure.",
      "properties": {
        "each": {
          "$ref": "#/$defs/pointer"
        },
        "where": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/property"
          },
          "additionalProperties": {
            "$ref": "#/$defs/test"
          }
        },
        "expect": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/property"
          },
          "additionalProperties": {
            "$ref": "#/$defs/test"
          }
        },
        "onFail": {
          "enum": [
            "gap",
            "warn"
          ],
          "default": "gap",
          "description": "warn: a trade-off to review, not a defect"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "avd-check-catalog/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped when a check is renamed or removed; adding one doesn't"
    },
    "extensions": {
      "type": "object",
      "description": "Optional upstream data, keyed by namespace; readers ignore what they don't know (contracts/README.md rule 1)"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "description": "IDs are unique within a catalog; the catalog's own repo tests it (avd-current-state), and tests/check_contracts.py tests the example",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "phase",
          "gate",
          "pillar",
          "severity",
          "claims"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,60}$",
            "description": "Stable, kebab case; reuses the landing zone portal's IDs where they exist; asm- is reserved for method checks, so a catalog check never shares an ID with one in method.json"
          },
          "deprecated": {
            "$ref": "#/$defs/deprecated"
          },
          "title": {
            "$ref": "#/$defs/line"
          },
          "phase": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "preflight",
                "postflight",
                "drift"
              ]
            }
          },
          "gate": {
            "enum": [
              "block",
              "advise"
            ],
            "description": "block: the deployment or the estate can't work, or the run couldn't check; advise: a recommendation or a finding to review"
          },
          "pillar": {
            "enum": [
              "reliability",
              "security",
              "cost",
              "operations",
              "performance"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/factId"
            }
          },
          "reads": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/claimRef"
                },
                {
                  "$ref": "#/$defs/gapRef"
                }
              ]
            }
          },
          "rule": {
            "$ref": "#/$defs/rule"
          },
          "impl": {
            "type": "string",
            "pattern": "^[A-Z][a-z]+-[A-Z][A-Za-z]{2,60}$",
            "description": "The coded check's function name in the reader's module"
          },
          "source": {
            "const": "method",
            "description": "A method check: its rule is in avd-assess method.json"
          },
          "remediation": {
            "$ref": "#/$defs/remediation"
          },
          "fixable": {
            "type": "boolean",
            "description": "true when avd-landing-zone has a fixer for this ID; informational"
          }
        },
        "oneOf": [
          {
            "required": [
              "rule"
            ]
          },
          {
            "required": [
              "impl"
            ]
          },
          {
            "required": [
              "source"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "source"
              ]
            },
            "then": {
              "properties": {
                "id": {
                  "pattern": "^asm-[a-z0-9-]{3,60}$"
                },
                "facts": false,
                "reads": false,
                "remediation": false,
                "fixable": false
              }
            },
            "else": {
              "properties": {
                "id": {
                  "not": {
                    "pattern": "^asm-"
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "rule"
              ]
            },
            "then": {
              "required": [
                "facts"
              ]
            }
          },
          {
            "if": {
              "required": [
                "impl"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "facts"
                  ]
                },
                {
                  "required": [
                    "reads"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  }
}
